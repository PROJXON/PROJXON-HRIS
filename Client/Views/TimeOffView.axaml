<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             xmlns:converters="using:Client.Utils.Converters"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="Client.Views.TimeOffView"
             x:DataType="vm:TimeOffViewModel"
             x:Name="Root">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    
    <Design.DataContext>
        <vm:TimeOffViewModel />
    </Design.DataContext>

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="40,32,40,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="8">
                <TextBlock Text="Time Off Requests"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F2937" />
                <TextBlock Text="Request and manage your time off"
                           FontSize="16"
                           Foreground="#6B7280" />
            </StackPanel>

            <!-- New Request Button -->
            <Button Grid.Column="1"
                    Command="{Binding OpenSubmitDialogCommand}"
                    Background="#1F2937"
                    Foreground="White"
                    CornerRadius="8"
                    Padding="20,12"
                    VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="+" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                    <TextBlock Text="New Request" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                      Margin="40,0,40,32"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="32">
                
                <!-- Balance Cards -->
                <Grid ColumnDefinitions="*,*,*">
                    <!-- Available PTO -->
                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="12"
                            Padding="24"
                            Margin="0,0,12,0"
                            BoxShadow="0 1 3 0 #10000000">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Available PTO"
                                       FontSize="14"
                                       Foreground="#6B7280" />
                            <TextBlock FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#1F2937">
                                <Run Text="{Binding DaysRemaining}" />
                                <Run Text=" days" FontSize="20" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Used This Year -->
                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="12"
                            Padding="24"
                            Margin="6,0,6,0"
                            BoxShadow="0 1 3 0 #10000000">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Used This Year"
                                       FontSize="14"
                                       Foreground="#6B7280" />
                            <TextBlock FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#1F2937">
                                <Run Text="{Binding DaysUsed}" />
                                <Run Text=" days" FontSize="20" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Pending Requests -->
                    <Border Grid.Column="2"
                            Background="White"
                            CornerRadius="12"
                            Padding="24"
                            Margin="12,0,0,0"
                            BoxShadow="0 1 3 0 #10000000">
                        <StackPanel Spacing="8">
                            <TextBlock Text="Pending Requests"
                                       FontSize="14"
                                       Foreground="#6B7280" />
                            <TextBlock FontSize="32"
                                       FontWeight="Bold"
                                       Foreground="#1F2937">
                                <Run Text="{Binding DaysPending}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- My Requests Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="My Requests"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#1F2937" />

                    <!-- Requests List -->
                    <ItemsControl ItemsSource="{Binding MyRequests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TimeOffRequestViewModel}">
                                <Border Background="White"
                                        CornerRadius="12"
                                        Padding="24"
                                        Margin="0,0,0,12"
                                        BoxShadow="0 1 3 0 #10000000">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <!-- Calendar Icon -->
                                        <Border Grid.Column="0"
                                                Background="#F3F4F6"
                                                CornerRadius="8"
                                                Width="48"
                                                Height="48"
                                                Margin="0,0,16,0">
                                            <Viewbox Width="24" Height="24"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center">
                                                <Canvas Width="24" Height="24">
                                                    <Rectangle Stroke="#374151"
                                                               StrokeThickness="2"
                                                               RadiusX="2"
                                                               RadiusY="2"
                                                               Width="18"
                                                               Height="18"
                                                               Canvas.Left="3"
                                                               Canvas.Top="4" />
                                                    <Path Stroke="#374151"
                                                          StrokeThickness="2"
                                                          Data="M16 2v4" />
                                                    <Path Stroke="#374151"
                                                          StrokeThickness="2"
                                                          Data="M8 2v4" />
                                                    <Path Stroke="#374151"
                                                          StrokeThickness="2"
                                                          Data="M3 10h18" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>

                                        <!-- Request Details -->
                                        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                                            <!-- Request Type and Status Badge -->
                                            <StackPanel Orientation="Horizontal" Spacing="12">
                                                <TextBlock Text="{Binding RequestType}"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Foreground="#1F2937" />
                                                <Border Background="{Binding StatusColor, Converter={x:Static converters:ColorToLightBackgroundConverter.Instance}}"
                                                        CornerRadius="4"
                                                        Padding="8,4">
                                                    <TextBlock Text="{Binding Status}"
                                                               FontSize="12"
                                                               FontWeight="Medium"
                                                               Foreground="{Binding StatusColor}" />
                                                </Border>
                                            </StackPanel>
                                            
                                            <!-- Date Range -->
                                            <TextBlock FontSize="14"
                                                       Foreground="#6B7280">
                                                <Run Text="{Binding DateRange}" />
                                            </TextBlock>

                                            <!-- Reason -->
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="Reason"
                                                           FontSize="13"
                                                           Foreground="#9CA3AF" />
                                                <TextBlock Text="{Binding Reason}"
                                                           FontSize="14"
                                                           Foreground="#374151" />
                                            </StackPanel>

                                            <!-- Review Info (if reviewed) -->
                                            <TextBlock Text="{Binding ReviewedInfo}"
                                                       FontSize="13"
                                                       Foreground="#6B7280"
                                                       IsVisible="{Binding IsReviewed}" />
                                        </StackPanel>

                                        <!-- Total Days -->
                                        <StackPanel Grid.Column="2" 
                                                    VerticalAlignment="Center"
                                                    Margin="16,0">
                                            <TextBlock Text="Total Days"
                                                       FontSize="13"
                                                       Foreground="#9CA3AF"
                                                       TextAlignment="Right" />
                                            <TextBlock Text="{Binding TotalDays}"
                                                       FontSize="24"
                                                       FontWeight="Bold"
                                                       Foreground="#1F2937"
                                                       TextAlignment="Right" />
                                        </StackPanel>

                                        <!-- Cancel Button (only for pending) -->
                                        <Button Grid.Column="3"
                                                Command="{Binding #Root.((vm:TimeOffViewModel)DataContext).OpenCancelDialogCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding IsPending}"
                                                Background="White"
                                                Foreground="#EF4444"
                                                BorderBrush="#FEE2E2"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="16,10"
                                                VerticalAlignment="Center">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#FEE2E2" />
                                                </Style>
                                            </Button.Styles>
                                            <TextBlock Text="Cancel" FontSize="14" FontWeight="Medium" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <Border IsVisible="{Binding HasNoRequests}"
                            Background="White"
                            CornerRadius="12"
                            Padding="48"
                            HorizontalAlignment="Stretch"
                            BoxShadow="0 1 3 0 #10000000">
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Viewbox Width="48" Height="48">
                                <Canvas Width="24" Height="24">
                                    <Rectangle Stroke="#D1D5DB"
                                               StrokeThickness="2"
                                               RadiusX="2"
                                               RadiusY="2"
                                               Width="18"
                                               Height="18"
                                               Canvas.Left="3"
                                               Canvas.Top="4" />
                                    <Path Stroke="#D1D5DB"
                                          StrokeThickness="2"
                                          Data="M16 2v4" />
                                    <Path Stroke="#D1D5DB"
                                          StrokeThickness="2"
                                          Data="M8 2v4" />
                                    <Path Stroke="#D1D5DB"
                                          StrokeThickness="2"
                                          Data="M3 10h18" />
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="No time off requests yet"
                                       FontSize="16"
                                       Foreground="#9CA3AF"
                                       TextAlignment="Center" />
                            <TextBlock Text="Click 'New Request' to submit your first request"
                                       FontSize="14"
                                       Foreground="#D1D5DB"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Submit Request Dialog Overlay -->
        <Grid IsVisible="{Binding IsSubmitDialogOpen}"
              Background="#80000000">
            <Border Background="White"
                    CornerRadius="12"
                    Padding="32"
                    Width="520"
                    MaxHeight="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24">
                        <!-- Dialog Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Request Time Off"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937" />
                                <TextBlock Text="Submit a new time off request for approval"
                                           FontSize="14"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding CloseSubmitDialogCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8"
                                    VerticalAlignment="Top">
                                <TextBlock Text="✕" FontSize="18" Foreground="#9CA3AF" />
                            </Button>
                        </Grid>

                        <!-- Form Fields -->
                        <StackPanel Spacing="20">
                            <!-- Request Type -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Request Type"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#1F2937" />
                                <ComboBox ItemsSource="{Binding TimeOffTypes}"
                                          SelectedItem="{Binding RequestType}"
                                          HorizontalAlignment="Stretch"
                                          Padding="16,12"
                                          CornerRadius="8"
                                          FontSize="14" />
                            </StackPanel>

                            <!-- Date Range -->
                            <Grid ColumnDefinitions="*,16,*">
                                <!-- Start Date -->
                                <StackPanel Grid.Column="0" Spacing="8">
                                    <TextBlock Text="Start Date"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Foreground="#1F2937" />
                                    <DatePicker SelectedDate="{Binding RequestStartDate}"
                                                HorizontalAlignment="Stretch"
                                                Padding="12"
                                                CornerRadius="8"
                                                FontSize="14"
                                                MinWidth="210" />
                                </StackPanel>

                                <!-- End Date -->
                                <StackPanel Grid.Column="2" Spacing="8">
                                    <TextBlock Text="End Date"
                                            FontSize="14"
                                            FontWeight="Medium"
                                            Foreground="#1F2937" />
                                    <DatePicker SelectedDate="{Binding RequestEndDate}"
                                                HorizontalAlignment="Stretch"
                                                Padding="12"
                                                CornerRadius="8"
                                                FontSize="14"
                                                MinWidth="210" />
                                </StackPanel>
                            </Grid>

                            <!-- Calculated Days -->
                            <Border Background="#F9FAFB"
                                    CornerRadius="8"
                                    Padding="16">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="Business Days:"
                                               FontSize="14"
                                               Foreground="#6B7280" />
                                    <TextBlock Text="{Binding CalculatedDays}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937" />
                                    <TextBlock Text="days"
                                               FontSize="14"
                                               Foreground="#6B7280" />
                                    <TextBlock Text="•"
                                               FontSize="14"
                                               Foreground="#D1D5DB"
                                               Margin="8,0" />
                                    <TextBlock Text="Available:"
                                               FontSize="14"
                                               Foreground="#6B7280" />
                                    <TextBlock Text="{Binding DaysRemaining}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#1F2937" />
                                    <TextBlock Text="days"
                                               FontSize="14"
                                               Foreground="#6B7280" />
                                </StackPanel>
                            </Border>

                            <!-- Reason -->
                            <StackPanel Spacing="8">
                                <TextBlock Text="Reason"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           Foreground="#1F2937" />
                                <TextBox Text="{Binding RequestReason}"
                                         Watermark="Please provide a reason for your time off request"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="100"
                                         Padding="16,12"
                                         CornerRadius="8"
                                         FontSize="14" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Submit Button -->
                        <Button Command="{Binding SubmitRequestCommand}"
                                Background="#1F2937"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="0,14"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#111827" />
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="Submit Request" FontSize="15" FontWeight="Medium" />
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Cancel Request Dialog Overlay -->
        <Grid IsVisible="{Binding IsCancelDialogOpen}"
              Background="#80000000">
            <Border Background="White"
                    CornerRadius="12"
                    Padding="32"
                    Width="480"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">
                <StackPanel Spacing="24">
                    <!-- Dialog Header -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Cancel Request"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937" />
                            <TextBlock Text="Are you sure you want to cancel this time off request?"
                                       FontSize="14"
                                       Foreground="#6B7280"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Command="{Binding CloseCancelDialogCommand}"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="8"
                                VerticalAlignment="Top">
                            <TextBlock Text="✕" FontSize="18" Foreground="#9CA3AF" />
                        </Button>
                    </Grid>

                    <!-- Request Summary -->
                    <Border Background="#F9FAFB"
                            CornerRadius="8"
                            Padding="16">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding RequestToCancel.RequestType}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#1F2937" />
                            <TextBlock Text="{Binding RequestToCancel.DateRange}"
                                       FontSize="14"
                                       Foreground="#6B7280" />
                            <TextBlock FontSize="14"
                                       Foreground="#6B7280">
                                <Run Text="{Binding RequestToCancel.TotalDays}" />
                                <Run Text="business days" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*">
                        <Button Grid.Column="0"
                                Command="{Binding CloseCancelDialogCommand}"
                                Background="White"
                                Foreground="#374151"
                                BorderBrush="#E5E7EB"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="0,14"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#F3F4F6" />
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="Keep Request" FontSize="15" FontWeight="Medium" />
                        </Button>
                        <Button Grid.Column="1"
                                Command="{Binding ConfirmCancelCommand}"
                                Background="#EF4444"
                                Foreground="White"
                                CornerRadius="8"
                                Padding="0,14"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center">
                            <Button.Styles>
                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                    <Setter Property="Background" Value="#DC2626" />
                                </Style>
                            </Button.Styles>
                            <TextBlock Text="Cancel Request" FontSize="15" FontWeight="Medium" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>