<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             xmlns:components="using:Client.Views.Components"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="1024"
             x:Class="Client.Views.InternDashboardView"
             x:DataType="vm:InternDashboardViewModel"
             x:Name="InternDashboardViewRoot">

    <Grid Background="#F8F9FA">
        
        <!-- Main Content Area -->
        <ScrollViewer Grid.Column="1"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="40,32,40,32" Spacing="32">
                
                <!-- Header -->
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding UserName, StringFormat='Welcome back, {0}!'}"
                               FontSize="28"
                               FontWeight="Bold"
                               Foreground="#1F2937" />
                    <TextBlock Text="Here's your overview for today."
                               FontSize="16"
                               Foreground="#6B7280" />
                </StackPanel>

                <!-- Stats Cards -->
                <Grid ColumnDefinitions="*,*,*,*">
                    <Grid.Styles>
                        <Style Selector="Border.stat-card">
                            <Setter Property="Background" Value="White" />
                            <Setter Property="CornerRadius" Value="12" />
                            <Setter Property="Padding" Value="24" />
                            <Setter Property="BorderBrush" Value="#E5E7EB" />
                            <Setter Property="BorderThickness" Value="1" />
                        </Style>
                    </Grid.Styles>
                    
                    <!-- Hours This Week -->
                    <Border Grid.Column="0" Classes="stat-card" Margin="0,0,12,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Hours This Week" FontSize="14" Foreground="#6B7280" />
                                <TextBlock Text="{Binding HoursThisWeek}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" />
                            </StackPanel>
                            <!-- Icon Blue: Clock -->
                            <Border Grid.Column="1" Background="#3B82F6" CornerRadius="10" Width="48" Height="48" VerticalAlignment="Center">
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <!-- Circle -->
                                        <Path Stroke="White" StrokeThickness="2" Data="M22 12C22 17.5228 17.5228 22 12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12Z" />
                                        <!-- Hands -->
                                        <Path Stroke="White" StrokeThickness="2" Data="M12 6v6l4 2" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Days Present -->
                    <Border Grid.Column="1" Classes="stat-card" Margin="6,0,6,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Days Present" FontSize="14" Foreground="#6B7280" />
                                <TextBlock Text="{Binding DaysPresent}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" />
                            </StackPanel>
                            <!-- Icon Green: Calendar -->
                            <Border Grid.Column="1" Background="#22C55E" CornerRadius="10" Width="48" Height="48" VerticalAlignment="Center">
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="White" StrokeThickness="2" Data="M8 2v4 M16 2v4 M3 10h18" />
                                        <Path Stroke="White" StrokeThickness="2" Data="M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2z" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Pending Tasks -->
                    <Border Grid.Column="2" Classes="stat-card" Margin="6,0,6,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Pending Tasks" FontSize="14" Foreground="#6B7280" />
                                <TextBlock Text="{Binding PendingTasks}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" />
                            </StackPanel>
                            <!-- Icon Orange: Checklist -->
                            <Border Grid.Column="1" Background="#F97316" CornerRadius="10" Width="48" Height="48" VerticalAlignment="Center">
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="White" StrokeThickness="2" Data="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
                                        <Path Stroke="White" StrokeThickness="2" Data="M9 14l2 2 4-4" />
                                        <Path Stroke="White" StrokeThickness="2" Data="M9 2h6a1 1 0 0 1 1 1v1a1 1 0 0 1-1 1H9a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Completed Tasks -->
                    <Border Grid.Column="3" Classes="stat-card" Margin="12,0,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Completed Tasks" FontSize="14" Foreground="#6B7280" />
                                <TextBlock Text="{Binding CompletedTasks}" FontSize="32" FontWeight="Bold" Foreground="#1F2937" />
                            </StackPanel>
                            <!-- Icon Purple: File Text -->
                            <Border Grid.Column="1" Background="#A855F7" CornerRadius="10" Width="48" Height="48" VerticalAlignment="Center">
                                <Viewbox Width="24" Height="24">
                                    <Canvas Width="24" Height="24">
                                        <Path Stroke="White" StrokeThickness="2" Data="M14 2v4a2 2 0 0 0 2 2h4" />
                                        <Path Stroke="White" StrokeThickness="2" Data="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7z" />
                                        <Path Stroke="White" StrokeThickness="2" Data="M10 9H8 M16 13H8 M16 17H8" />
                                    </Canvas>
                                </Viewbox>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Activity + Tasks Side-by-Side -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="24">

                    <!-- UPCOMING TASKS SECTION -->
                    <Border Grid.Column="0"
                            Background="White"
                            CornerRadius="12"
                            Padding="24"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">

                        <StackPanel Spacing="16">
                            <TextBlock Text="Upcoming Tasks"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#1F2937" />

                            <ItemsControl ItemsSource="{Binding UpcomingTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,12"
                                                BorderBrush="#F3F4F6"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" Foreground="#1F2937" />
                                                        <Border Background="#F3F4F6" CornerRadius="4" Padding="6,2">
                                                            <TextBlock Text="{Binding Type}" FontSize="11" Foreground="#4B5563"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding DueDate, StringFormat='Due: {0:MMM dd, yyyy}'}" FontSize="13" Foreground="#6B7280" />
                                                </StackPanel>
                                                
                                                <Button Grid.Column="1" 
                                                        Command="{Binding #InternDashboardViewRoot.((vm:InternDashboardViewModel)DataContext).NavigateToTasksCommand}"
                                                        Background="#1F2937" Foreground="White" 
                                                        CornerRadius="6" Padding="12,6" FontSize="12">
                                                    <TextBlock Text="View Details"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Empty State -->
                            <TextBlock Text="No upcoming tasks" 
                                       IsVisible="{Binding !UpcomingTasks.Count}"
                                       Foreground="#9CA3AF" 
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Margin="0,20"/>
                        </StackPanel>
                    </Border>

                    <!-- Recent Activity -->
                    <Border Grid.Column="1"
                            Background="White"
                            CornerRadius="12"
                            Padding="24"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">
                        
                        <StackPanel Spacing="16">
                            <TextBlock Text="Recent Activity"
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="#1F2937" />

                            <ItemsControl ItemsSource="{Binding RecentActivities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="0,12"
                                                BorderBrush="#F3F4F6"
                                                BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Ellipse Grid.Column="0"
                                                        Width="8" Height="8"
                                                        Fill="#3B82F6"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,16,0" />

                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding Title}"
                                                            FontSize="14"
                                                            FontWeight="Medium"
                                                            Foreground="#1F2937" />
                                                    <TextBlock Text="{Binding TimeAgo}"
                                                            FontSize="13"
                                                            Foreground="#6B7280" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <!-- Empty State -->
                            <TextBlock Text="No recent activity" 
                                       IsVisible="{Binding !RecentActivities.Count}"
                                       Foreground="#9CA3AF" 
                                       FontStyle="Italic"
                                       HorizontalAlignment="Center"
                                       Margin="0,20"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>