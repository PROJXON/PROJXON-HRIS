<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             xmlns:converters="using:Client.Utils.Converters"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="Client.Views.TimeOffRequestsView"
             x:DataType="vm:TimeOffRequestsViewModel"
             x:Name="Root">
    
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>
    
    <Design.DataContext>
        <vm:TimeOffRequestsViewModel />
    </Design.DataContext>

    <Grid Background="#F8F9FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="40,32,40,24">
            <StackPanel Spacing="8">
                <TextBlock Text="Time Off Requests"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#1F2937" />
                <TextBlock Text="Review and manage employee time off requests"
                           FontSize="16"
                           Foreground="#6B7280" />
            </StackPanel>
        </Grid>

        <!-- Main Content -->
        <ScrollViewer Grid.Row="1" 
                      Margin="40,0,40,32"
                      VerticalScrollBarVisibility="Auto">
            
            <!-- Requests Table -->
            <Border Background="White"
                    CornerRadius="12"
                    Padding="0"
                    BoxShadow="0 1 3 0 #10000000">
                <StackPanel>
                    <!-- Table Header -->
                    <Grid Background="#F9FAFB"
                          Margin="24,16"
                          ColumnDefinitions="2*,1.2*,1.2*,1*,1.5*,1*,1.5*">
                        <TextBlock Grid.Column="0"
                                   Text="Employee Name"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />
                        <TextBlock Grid.Column="1"
                                   Text="Leave From"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />
                        <TextBlock Grid.Column="2"
                                   Text="Leave To"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />
                        <TextBlock Grid.Column="3"
                                   Text="Total Days"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />
                        <TextBlock Grid.Column="4"
                                   Text="Leave Type"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />
                        <TextBlock Grid.Column="5"
                                   Text="Status"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />
                        <TextBlock Grid.Column="6"
                                   Text="Actions"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="#374151" />
                    </Grid>

                    <!-- Separator -->
                    <Rectangle Height="1" Fill="#E5E7EB" />

                    <!-- Table Rows -->
                    <ItemsControl ItemsSource="{Binding FilteredRequests}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:TimeOffRequestItemViewModel}">
                                <StackPanel>
                                    <Grid x:Name="TableRow"
                                          Margin="24,20"
                                          ColumnDefinitions="2*,1.2*,1.2*,1*,1.5*,1*,1.5*"
                                          Background="Transparent">
                                        <Grid.Styles>
                                            <Style Selector="Grid#TableRow:pointerover">
                                                <Setter Property="Background" Value="#F9FAFB" />
                                            </Style>
                                        </Grid.Styles>

                                        <!-- Employee Name -->
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding InternName}"
                                                   FontSize="14"
                                                   Foreground="#1F2937"
                                                   VerticalAlignment="Center" />

                                        <!-- Leave From -->
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding StartDate, StringFormat={}{0:MM/dd/yyyy}}"
                                                   FontSize="14"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center" />

                                        <!-- Leave To -->
                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding EndDate, StringFormat={}{0:MM/dd/yyyy}}"
                                                   FontSize="14"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center" />

                                        <!-- Total Days -->
                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding DaysText}"
                                                   FontSize="14"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center" />

                                        <!-- Leave Type -->
                                        <TextBlock Grid.Column="4"
                                                   Text="{Binding RequestType}"
                                                   FontSize="14"
                                                   Foreground="#374151"
                                                   VerticalAlignment="Center" />

                                        <!-- Status Badge -->
                                        <Border Grid.Column="5"
                                                Background="{Binding StatusBadgeBackground}"
                                                CornerRadius="12"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{Binding StatusColor}"
                                                       TextAlignment="Center" />
                                        </Border>

                                        <!-- Action Buttons -->
                                        <StackPanel Grid.Column="6"
                                                    Orientation="Horizontal"
                                                    Spacing="6"
                                                    VerticalAlignment="Center">
                                            <!-- Approve Button (only for pending) -->
                                            <Button Command="{Binding #Root.((vm:TimeOffRequestsViewModel)DataContext).OpenReviewDialogCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding IsPending}"
                                                    Background="#1F2937"
                                                    Foreground="White"
                                                    CornerRadius="6"
                                                    Padding="12,8"
                                                    VerticalAlignment="Center">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="#111827" />
                                                    </Style>
                                                </Button.Styles>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="✓" FontSize="13" FontWeight="Bold" />
                                                    <TextBlock Text="Approve" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Decline Button (only for pending) -->
                                            <Button Command="{Binding #Root.((vm:TimeOffRequestsViewModel)DataContext).OpenReviewDialogCommand}"
                                                    CommandParameter="{Binding}"
                                                    IsVisible="{Binding IsPending}"
                                                    Background="#EF4444"
                                                    Foreground="White"
                                                    CornerRadius="6"
                                                    Padding="12,8"
                                                    VerticalAlignment="Center">
                                                <Button.Styles>
                                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                        <Setter Property="Background" Value="#DC2626" />
                                                    </Style>
                                                </Button.Styles>
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <TextBlock Text="✕" FontSize="13" FontWeight="Bold" />
                                                    <TextBlock Text="Decline" FontSize="12" />
                                                </StackPanel>
                                            </Button>

                                            <!-- Reviewed Status (for approved/denied) -->
                                            <TextBlock IsVisible="{Binding IsReviewed}"
                                                    Text="{Binding Status}"
                                                    FontSize="14"
                                                    Foreground="#9CA3AF"
                                                    VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Row Separator -->
                                    <Rectangle Height="1" Fill="#F3F4F6" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty State -->
                    <StackPanel IsVisible="{Binding HasNoRequests}"
                                Margin="48"
                                Spacing="12"
                                HorizontalAlignment="Center">
                        <Viewbox Width="48" Height="48">
                            <Canvas Width="24" Height="24">
                                <Rectangle Stroke="#D1D5DB"
                                           StrokeThickness="2"
                                           RadiusX="2"
                                           RadiusY="2"
                                           Width="18"
                                           Height="18"
                                           Canvas.Left="3"
                                           Canvas.Top="4" />
                                <Path Stroke="#D1D5DB"
                                      StrokeThickness="2"
                                      Data="M16 2v4" />
                                <Path Stroke="#D1D5DB"
                                      StrokeThickness="2"
                                      Data="M8 2v4" />
                                <Path Stroke="#D1D5DB"
                                      StrokeThickness="2"
                                      Data="M3 10h18" />
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="No time off requests"
                                   FontSize="16"
                                   Foreground="#9CA3AF"
                                   TextAlignment="Center" />
                        <TextBlock Text="When employees submit time off requests, they will appear here"
                                   FontSize="14"
                                   Foreground="#D1D5DB"
                                   TextAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <!-- Review Dialog Overlay -->
        <Grid IsVisible="{Binding IsReviewDialogOpen}"
              Background="#80000000">
            <Border Background="White"
                    CornerRadius="12"
                    Padding="32"
                    Width="520"
                    MaxHeight="700"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 0 #40000000">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="24">
                        <!-- Dialog Header -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Review Time Off Request"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="#1F2937" />
                                <TextBlock Text="Approve or deny this time off request"
                                           FontSize="14"
                                           Foreground="#6B7280"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="1"
                                    Command="{Binding CloseReviewDialogCommand}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Padding="8"
                                    VerticalAlignment="Top">
                                <TextBlock Text="✕" FontSize="18" Foreground="#9CA3AF" />
                            </Button>
                        </Grid>

                        <!-- Employee Info -->
                        <Border Background="#F9FAFB"
                                CornerRadius="8"
                                Padding="20">
                            <StackPanel Spacing="12">
                                <!-- Employee Name -->
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <!-- Avatar -->
                                    <Border Background="#E5E7EB"
                                            CornerRadius="20"
                                            Width="40"
                                            Height="40">
                                        <TextBlock Text="{Binding RequestToReview.InternInitial}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#6B7280"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding RequestToReview.InternName}"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="#1F2937" />
                                        <TextBlock Text="{Binding RequestToReview.RequestType}"
                                                   FontSize="14"
                                                   Foreground="#6B7280" />
                                    </StackPanel>
                                </StackPanel>

                                <!-- Request Details -->
                                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="16" RowSpacing="12">
                                    <!-- Start Date -->
                                    <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                                        <TextBlock Text="Start Date"
                                                   FontSize="12"
                                                   Foreground="#9CA3AF" />
                                        <TextBlock Text="{Binding RequestToReview.StartDate, StringFormat={}{0:MM/dd/yyyy}}"
                                                   FontSize="14"
                                                   Foreground="#1F2937" />
                                    </StackPanel>

                                    <!-- End Date -->
                                    <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                                        <TextBlock Text="End Date"
                                                   FontSize="12"
                                                   Foreground="#9CA3AF" />
                                        <TextBlock Text="{Binding RequestToReview.EndDate, StringFormat={}{0:MM/dd/yyyy}}"
                                                   FontSize="14"
                                                   Foreground="#1F2937" />
                                    </StackPanel>

                                    <!-- Total Days -->
                                    <StackPanel Grid.Column="0" Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Total Days"
                                                   FontSize="12"
                                                   Foreground="#9CA3AF" />
                                        <TextBlock Text="{Binding RequestToReview.DaysText}"
                                                   FontSize="14"
                                                   Foreground="#1F2937" />
                                    </StackPanel>

                                    <!-- Submitted Date -->
                                    <StackPanel Grid.Column="1" Grid.Row="1" Spacing="4">
                                        <TextBlock Text="Submitted"
                                                   FontSize="12"
                                                   Foreground="#9CA3AF" />
                                        <TextBlock Text="{Binding RequestToReview.SubmittedDate, StringFormat={}{0:MM/dd/yyyy}}"
                                                   FontSize="14"
                                                   Foreground="#1F2937" />
                                    </StackPanel>

                                    <!-- Reason -->
                                    <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Spacing="4">
                                        <TextBlock Text="Reason"
                                                   FontSize="12"
                                                   Foreground="#9CA3AF" />
                                        <TextBlock Text="{Binding RequestToReview.Reason}"
                                                   FontSize="14"
                                                   Foreground="#1F2937"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Review Notes (Optional) -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Review Notes (Optional)"
                                       FontSize="14"
                                       FontWeight="Medium"
                                       Foreground="#1F2937" />
                            <TextBox Text="{Binding ReviewNotes}"
                                     Watermark="Add any notes about your decision..."
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="80"
                                     Padding="16,12"
                                     CornerRadius="8"
                                     FontSize="14" />
                        </StackPanel>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*,*">
                            <Button Grid.Column="0"
                                    Command="{Binding DenyRequestCommand}"
                                    Background="White"
                                    Foreground="#EF4444"
                                    BorderBrush="#FEE2E2"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="0,14"
                                    Margin="0,0,8,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#FEE2E2" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="✕" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="Deny" FontSize="15" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Command="{Binding ApproveRequestCommand}"
                                    Background="#10B981"
                                    Foreground="White"
                                    CornerRadius="8"
                                    Padding="0,14"
                                    Margin="8,0,0,0"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Center">
                                <Button.Styles>
                                    <Style Selector="Button:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#059669" />
                                    </Style>
                                </Button.Styles>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="✓" FontSize="16" FontWeight="Bold" />
                                    <TextBlock Text="Approve" FontSize="15" FontWeight="Medium" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>