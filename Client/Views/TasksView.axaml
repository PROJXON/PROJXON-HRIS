<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Client.ViewModels"
             xmlns:components="using:Client.Views.Components"
             xmlns:responses="using:Shared.EmployeeManagement.Responses"
             mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
             x:Class="Client.Views.TasksView"
             x:DataType="vm:TasksViewModel"
             x:Name="Root">

    <Design.DataContext>
        <vm:TasksViewModel />
    </Design.DataContext>

    <Grid Background="#F8F9FA">
        
        <!-- Main Content -->
        <ScrollViewer Grid.Column="1" Padding="40">
            <StackPanel Spacing="32">
                
                <!-- Header -->
                <StackPanel Spacing="8">
                    <TextBlock Text="Tasks" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Foreground="#1F2937"/>
                    <TextBlock Text="Complete assigned tasks" 
                               FontSize="16" 
                               Foreground="#6B7280"/>
                </StackPanel>

                <!-- Loading State -->
                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" />

                <!-- Pending Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding PendingTasks.Count, StringFormat='Pending ({0})'}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#374151"/>

                    <ItemsControl ItemsSource="{Binding PendingTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="responses:TaskItemResponse">
                                <Border Background="White" 
                                        CornerRadius="12" 
                                        Padding="24" 
                                        Margin="0,0,0,16" 
                                        BorderBrush="#E5E7EB" 
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Icon -->
                                        <Border Grid.Column="0" 
                                                Background="#FFF7ED" 
                                                Width="48" 
                                                Height="48" 
                                                CornerRadius="8" 
                                                Margin="0,0,20,0">
                                            <Viewbox Width="24" Height="24">
                                                <Canvas Width="24" Height="24">
                                                    <!-- Document Icon -->
                                                    <Path Stroke="#EA580C" StrokeThickness="2" Data="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                                    <Path Stroke="#EA580C" StrokeThickness="2" Data="M14 2v6h6" />
                                                    <Path Stroke="#EA580C" StrokeThickness="2" Data="M16 13H8" />
                                                    <Path Stroke="#EA580C" StrokeThickness="2" Data="M16 17H8" />
                                                    <Path Stroke="#EA580C" StrokeThickness="2" Data="M10 9H8" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Title}" 
                                                           FontSize="16" 
                                                           FontWeight="Medium" 
                                                           Foreground="#1F2937"/>
                                                <!-- Tag -->
                                                <Border Background="#F3F4F6" CornerRadius="4" Padding="8,2">
                                                    <TextBlock Text="{Binding Type}" FontSize="12" Foreground="#4B5563"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="Please complete this task" 
                                                       FontSize="14" 
                                                       Foreground="#6B7280"/>
                                            <TextBlock Text="{Binding DueDate, StringFormat='Due: {0:MMMM dd, yyyy}'}" 
                                                       FontSize="13" 
                                                       Foreground="#6B7280"/>
                                        </StackPanel>

                                        <!-- Action Button -->
                                        <Button Grid.Column="2"
                                                Command="{Binding #Root.((vm:TasksViewModel)DataContext).CompleteSurveyCommand}"
                                                CommandParameter="{Binding}"
                                                IsVisible="{Binding !IsCompleted}"
                                                Background="#1F2937"
                                                Foreground="White"
                                                CornerRadius="8"
                                                Padding="16,10"
                                                Cursor="Hand">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#111827" />
                                                </Style>
                                            </Button.Styles>
                                            <TextBlock Text="Complete Survey" FontWeight="Medium"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    
                    <!-- Empty State Pending -->
                    <Border IsVisible="{Binding !PendingTasks.Count}" 
                            Background="#F9FAFB" 
                            BorderBrush="#E5E7EB" 
                            BorderThickness="1" 
                            CornerRadius="8" 
                            Padding="24">
                        <TextBlock Text="No pending tasks. Great job!" 
                                   HorizontalAlignment="Center" 
                                   Foreground="#6B7280"/>
                    </Border>
                </StackPanel>

                <!-- Completed Section -->
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding CompletedTasks.Count, StringFormat='Completed ({0})'}" 
                               FontSize="16" 
                               FontWeight="SemiBold" 
                               Foreground="#374151"/>

                    <ItemsControl ItemsSource="{Binding CompletedTasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="responses:TaskItemResponse">
                                <Border Background="White" 
                                        CornerRadius="12" 
                                        Padding="24" 
                                        Margin="0,0,0,16" 
                                        BorderBrush="#E5E7EB" 
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <!-- Check Icon -->
                                        <Border Grid.Column="0" 
                                                Background="#DCFCE7" 
                                                Width="48" 
                                                Height="48" 
                                                CornerRadius="8" 
                                                Margin="0,0,20,0">
                                            <Viewbox Width="24" Height="24">
                                                <Canvas Width="24" Height="24">
                                                    <Path Stroke="#166534" StrokeThickness="2" Data="M20 6L9 17l-5-5" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>

                                        <!-- Content -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                <TextBlock Text="{Binding Title}" 
                                                           FontSize="16" 
                                                           FontWeight="Medium" 
                                                           Foreground="#1F2937"/>
                                                <Border Background="#1F2937" CornerRadius="4" Padding="8,2">
                                                    <TextBlock Text="{Binding Type}" FontSize="12" Foreground="White"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding CompletedDate, StringFormat='Completed on {0:MMMM dd, yyyy}'}" 
                                                       FontSize="13" 
                                                       Foreground="#6B7280"/>
                                        </StackPanel>

                                        <!-- View Response Button -->
                                        <Button Grid.Column="2"
                                                Command="{Binding #Root.((vm:TasksViewModel)DataContext).ViewResponseCommand}"
                                                CommandParameter="{Binding}"
                                                Background="White"
                                                BorderBrush="#E5E7EB"
                                                BorderThickness="1"
                                                Foreground="#374151"
                                                CornerRadius="8"
                                                Padding="16,10"
                                                Cursor="Hand">
                                            <Button.Styles>
                                                <Style Selector="Button:pointerover /template/ ContentPresenter">
                                                    <Setter Property="Background" Value="#F9FAFB" />
                                                </Style>
                                            </Button.Styles>
                                            <TextBlock Text="View Response"/>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
